# http://editorconfig.org
root = true

# Configuración base para todos los archivos
[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Archivos web (JSON, YAML, XML) suelen usar 2 espacios
[*.{json,yaml,yml,xml}]
indent_size = 2

# Markdown (a veces necesita espacios al final para saltos de línea, pero lo estandarizamos)
[*.md]
trim_trailing_whitespace = false
