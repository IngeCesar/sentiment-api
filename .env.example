# ==============================================================================
# CESIUMFLOW - ENVIRONMENT TEMPLATE
# ==============================================================================
# Instrucciones:
# 1. Copie este archivo y renombrelo como '.env'
# 2. Ajuste los valores según su entorno local.
# 3. NUNCA suba el archivo '.env' final al repositorio.
# ==============================================================================

# --- PERSISTENCIA (PostgreSQL) ---
# Credenciales para la base de datos relacional.
DB_NAME=cesium_sentiment_db
DB_USER=cesium_admin
DB_PASSWORD=your_secure_password_here

# --- NETWORKING & MICROSERVICIOS ---
# URL base para la comunicación interna entre servicios.
# En Docker Compose, se utiliza el nombre del servicio como hostname.
PYTHON_ENGINE_URL=http://sentiment-engine:5000